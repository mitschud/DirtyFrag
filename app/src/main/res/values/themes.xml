<resources>
    <!-- Framework Material, dark, no action bar. There is no
         Theme.Material3.DynamicColors parent here any more, and that is the whole point:
         the wallpaper palette used to leak into every attribute this theme left unset -
         that was the purple flash on cold start. Now nothing can leak, because there is
         no palette-aware theme underneath; what is written down is what draws.
         It is dark rather than DayNight: every surface and every on* colour was pinned to
         the dark ramp anyway, so the DayNight parent only ever risked a light frame. -->
    <style name="Theme.DirtyFrag" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:windowBackground">@color/black</item>
        <item name="android:statusBarColor">@color/black</item>
        <item name="android:navigationBarColor">@color/black</item>
        <!-- android:colorBackground is what the starting window and the splash fall back
             to, so it is the important line here. -->
        <item name="android:colorBackground">@color/black</item>
        <!-- Every press highlight in the app: 30% mid-grey, never white. PillButton draws
             its own ripple in the same #4D6E6E6E, as do the explicit ripple drawables. -->
        <item name="android:colorControlHighlight">#4D6E6E6E</item>
        <item name="android:colorAccent">#FFC9C9C9</item>
        <item name="android:colorControlActivated">#FFC9C9C9</item>
        <item name="android:colorPrimary">#FFB0B0B0</item>
        <item name="android:colorPrimaryDark">@color/black</item>
        <item name="android:textColorHighlight">#4D6E6E6E</item>
        <!-- System splash screen. minSdk is 32, so these live here and NOT in a
             values-v31 copy: that copy used to redefine this whole theme, which
             silently overrode everything else on every supported device.
             Background is BLACK, not transparent - a transparent splash lets
             OneUI fall back to its own surface. The animated icon is a transparent
             colour so no icon is shown at all. -->
        <item name="android:windowSplashScreenBackground">@color/black</item>
        <item name="android:windowSplashScreenAnimatedIcon">@android:color/transparent</item>
        <!-- Card-styled popup menu (rounded #1C1C1C background). -->
        <item name="android:popupMenuStyle">@style/DF_PopupMenu</item>
        <item name="android:actionOverflowMenuStyle">@style/DF_OverflowMenu</item>
        <!-- Must live on the theme (not the popup style): the popup's ListView
             reads this attr from the activity theme. Provides the centered
             divider between menu items. -->
        <item name="android:dropDownListViewStyle">@style/DF_DropDownListView</item>
        <item name="android:itemTextAppearance">@style/DF_MenuText</item>
        <item name="android:textAppearanceListItemSmall">@style/DF_MenuText</item>
        <!-- Popup sizing: taller rows, narrower side padding. -->
        <item name="android:listPreferredItemHeightSmall">56dp</item>
        <item name="android:listPreferredItemPaddingLeft">12dp</item>
        <item name="android:listPreferredItemPaddingRight">12dp</item>
    </style>
    <style name="DF_MenuText" parent="@android:style/TextAppearance.Material">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">#FFE8E8E8</item>
        <item name="android:gravity">center</item>
    </style>
    <style name="DF_PopupMenu" parent="@android:style/Widget.Material.PopupMenu">
        <item name="android:popupBackground">@drawable/popup_bg</item>
        <item name="android:popupElevation">24dp</item>
    </style>
    <style name="DF_OverflowMenu" parent="@android:style/Widget.Material.PopupMenu.Overflow">
        <item name="android:popupBackground">@drawable/popup_bg</item>
        <item name="android:popupElevation">24dp</item>
    </style>
    <style name="DF_DropDownListView" parent="@android:style/Widget.Material.ListView">
        <item name="android:divider">@drawable/menu_divider</item>
        <item name="android:dividerHeight">1dp</item>
        <item name="android:listSelector">@drawable/menu_item_ripple</item>
    </style>
    <!-- OneUI-style bold toolbar title. Framework TextAppearance.Material.Title is the
         closest parent now that TextAppearance.Material3.TitleLarge is not on screen. -->
    <style name="ToolbarTitle" parent="@android:style/TextAppearance.Material.Title">
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textFontWeight">700</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/white</item>
    </style>
</resources>
